# FastAPI runtime; health endpoints work without integrations.
AI_ENVIRONMENT=development
AI_SERVICE_NAME=Farasha AI Service
AI_HOST=127.0.0.1
AI_PORT=8000

# Server-to-server only; keep browser origins empty.
AI_CORS_ORIGINS=
AI_INTERNAL_SERVICE_TOKEN=
AI_WEB_TOOLS_URL=http://127.0.0.1:3000/api/internal/ai/tools

# Gemini is optional locally; AI chat is unavailable until configured.
GEMINI_API_KEY=
GEMINI_MODEL=
