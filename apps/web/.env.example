# Copy this file to .env.local and replace placeholders with local values.
SITE_URL=http://localhost:3000

# PostgreSQL; required only when using the Phase 3 database layer.
DATABASE_URL="postgresql://USER:PERCENT_ENCODED_PASSWORD@HOST:5432/DATABASE?schema=public"

# Auth.js; generate a random value with `npx auth secret`. Keep it in .env.local only.
AUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"

# Optional integrations; blank values never block web startup or checkout.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# WhatsApp Cloud API; dispatch remains unavailable until valid values and approved templates are configured.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE_CODE=
WHATSAPP_DEFAULT_COUNTRY_CODE=
WHATSAPP_TEMPLATE_ORDER_CREATED=
WHATSAPP_TEMPLATE_ORDER_CONFIRMED=
WHATSAPP_TEMPLATE_ORDER_PROCESSING=
WHATSAPP_TEMPLATE_ORDER_SHIPPED=
WHATSAPP_TEMPLATE_ORDER_DELIVERED=
WHATSAPP_TEMPLATE_ORDER_CANCELLED=
AI_SERVICE_URL=http://127.0.0.1:8000
# Set the same random 32+ character secret in the web and AI service env files.
AI_INTERNAL_SERVICE_TOKEN=
CRON_SECRET=
