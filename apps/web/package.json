{
  "name": "@shimo-gift/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:auth": "node --test tests/auth-foundation.test.mjs",
    "test:admin": "node --test tests/admin-foundation.test.mjs",
    "test:orders": "node --test tests/order-workflow.test.mjs",
    "test:cart": "node --test tests/cart-workflow.test.mjs",
    "test:checkout": "node --test tests/checkout-security.test.mjs",
    "test:phase7": "node --test tests/phase7-validation.test.mjs",
    "test:phase10": "node --test tests/phase10-orders-inventory.test.mjs",
    "test:phase11": "node --test tests/phase11-admin-dashboard.test.mjs",
    "test:phase12": "node --test tests/phase12-whatsapp.test.mjs",
    "test:phase13": "node --test tests/phase13-ai.test.mjs",
    "test:phase14": "node --test tests/phase14-seo.test.mjs",
    "test:phase15": "node --test tests/phase15-performance.test.mjs",
    "test:phase16": "node --test tests/phase16-security.test.mjs",
    "test:deployment": "node --test tests/deployment-config.test.mjs",
    "auth:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "db:generate": "prisma generate --config ../../prisma.config.ts",
    "db:validate": "prisma validate --config ../../prisma.config.ts",
    "db:format": "prisma format --config ../../prisma.config.ts",
    "db:migrate:dev": "prisma migrate dev --config ../../prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config ../../prisma.config.ts",
    "db:migrate:status": "prisma migrate status --config ../../prisma.config.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "next": "^16.0.0",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
