{
  "name": "shimo-gift",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @shimo-gift/web",
    "build:web": "npm run build --workspace @shimo-gift/web",
    "start:web": "npm run start --workspace @shimo-gift/web",
    "lint:web": "npm run lint --workspace @shimo-gift/web",
    "typecheck:web": "npm run typecheck --workspace @shimo-gift/web",
    "validate:web": "npm run lint:web && npm run typecheck:web && npm run build:web",
    "test:auth": "npm run test:auth --workspace @shimo-gift/web",
    "test:admin": "npm run test:admin --workspace @shimo-gift/web",
    "test:orders": "npm run test:orders --workspace @shimo-gift/web",
    "test:cart": "npm run test:cart --workspace @shimo-gift/web",
    "test:checkout": "npm run test:checkout --workspace @shimo-gift/web",
    "test:phase7": "npm run test:phase7 --workspace @shimo-gift/web",
    "test:phase10": "npm run test:phase10 --workspace @shimo-gift/web",
    "test:phase11": "npm run test:phase11 --workspace @shimo-gift/web",
    "test:phase12": "npm run test:phase12 --workspace @shimo-gift/web",
    "test:phase13": "npm run test:phase13 --workspace @shimo-gift/web",
    "test:phase14": "npm run test:phase14 --workspace @shimo-gift/web",
    "test:phase15": "npm run test:phase15 --workspace @shimo-gift/web",
    "test:phase16": "npm run test:phase16 --workspace @shimo-gift/web",
    "test:deployment": "npm run test:deployment --workspace @shimo-gift/web",
    "auth:bootstrap-admin": "npm run auth:bootstrap-admin --workspace @shimo-gift/web",
    "db:generate": "npm run db:generate --workspace @shimo-gift/web",
    "db:validate": "npm run db:validate --workspace @shimo-gift/web",
    "db:format": "npm run db:format --workspace @shimo-gift/web",
    "db:migrate:dev": "npm run db:migrate:dev --workspace @shimo-gift/web --",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @shimo-gift/web",
    "db:migrate:status": "npm run db:migrate:status --workspace @shimo-gift/web"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0"
  }
}