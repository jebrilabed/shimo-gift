generator client {
  provider        = "prisma-client"
  output          = "../apps/web/src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  AR @map("ar")
  EN @map("en")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductKind {
  SIMPLE
  VARIANT
}

enum CategoryStatus {
  ACTIVE
  ARCHIVED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @db.Timestamptz(3)
  image         String?
  passwordHash  String?   @db.Text
  role          UserRole  @default(CUSTOMER)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  accounts      Account[]
  sessions      Session[]
  customer      Customer?
  carts         Cart[]
  orders        Order[]
  auditLogs     AdminAuditLog[]
  conversations ChatConversation[]
  addresses     CustomerAddress[]

  @@map("users")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  oauth_token_secret String? @db.Text
  oauth_token        String? @db.Text
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Customer {
  id        String   @id @default(cuid())
  userId    String?  @unique
  name      String?
  email     String?
  phone     String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  carts         Cart[]
  orders        Order[]
  conversations ChatConversation[]

  @@index([email])
  @@index([phone])
  @@map("customers")
}

model Product {
  id             String        @id @default(cuid())
  slug           String        @unique
  kind           ProductKind   @default(SIMPLE)
  status         ProductStatus @default(DRAFT)
  featured       Boolean       @default(false)
  categoryId     String?
  seoTitle       String?
  seoDescription String?       @db.Text
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  category     Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  translations ProductTranslation[]
  skus         ProductSku[]
  images       ProductImage[]

  @@index([status, createdAt])
  @@index([categoryId, status])
  @@index([featured, status])
  @@map("products")
}

model ProductTranslation {
  id               String  @id @default(cuid())
  productId        String
  locale           Locale
  name             String
  shortDescription String? @db.Text
  description      String? @db.Text
  slug             String
  seoTitle         String?
  seoDescription   String? @db.Text
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([productId, locale])
  @@unique([locale, slug])
  @@map("product_translations")
}

model ProductSku {
  id             String   @id @default(cuid())
  productId      String
  skuCode        String   @unique
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  stockQuantity  Int      @default(0)
  isActive       Boolean  @default(true)
  isDefault      Boolean  @default(false)
  variantOptions Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId], where: { isDefault: true })
  @@index([productId, isActive])
  @@index([isActive, stockQuantity])
  @@map("product_skus")
}

model ProductImage {
  id               String   @id @default(cuid())
  productId        String
  url              String   @db.Text
  providerPublicId String?
  sortOrder        Int      @default(0)
  altText          String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model Category {
  id             String         @id @default(cuid())
  slug           String         @unique
  parentId       String?
  status         CategoryStatus @default(ACTIVE)
  sortOrder      Int            @default(0)
  seoTitle       String?
  seoDescription String?        @db.Text
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children     Category[]            @relation("CategoryTree")
  products     Product[]
  translations CategoryTranslation[]

  @@index([parentId, status, sortOrder])
  @@map("categories")
}

model CategoryTranslation {
  id             String   @id @default(cuid())
  categoryId     String
  locale         Locale
  name           String
  description    String?  @db.Text
  slug           String
  seoTitle       String?
  seoDescription String?  @db.Text
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@map("category_translations")
}

model Cart {
  id             String     @id @default(cuid())
  userId         String?
  customerId     String?
  guestTokenHash String?    @unique
  status         CartStatus @default(ACTIVE)
  expiresAt      DateTime?  @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  user     User?      @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items    CartItem[]

  @@index([userId, status])
  @@index([customerId, status])
  @@index([status, updatedAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  skuId     String
  quantity  Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  cart Cart       @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sku  ProductSku @relation(fields: [skuId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([cartId, skuId])
  @@index([skuId])
  @@map("cart_items")
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  idempotencyKey  String?       @unique
  userId          String?
  customerId      String?
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  contactName     String
  contactEmail    String?
  contactPhone    String
  shippingAddress Json
  currency        String
  subtotal        Decimal       @db.Decimal(12, 2)
  shippingCost    Decimal       @default(0) @db.Decimal(12, 2)
  discountTotal   Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  customerNote    String?       @db.Text
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  customer      Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items         OrderItem[]
  notifications NotificationOutbox[]

  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([createdAt])
  @@index([customerId, createdAt])
  @@index([userId, createdAt])
  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  skuId               String?
  productNameSnapshot String
  skuCodeSnapshot     String
  variantSnapshot     Json?
  unitPrice           Decimal  @db.Decimal(12, 2)
  quantity            Int
  subtotal            Decimal  @db.Decimal(12, 2)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  order Order       @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sku   ProductSku? @relation(fields: [skuId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([orderId])
  @@index([skuId])
  @@map("order_items")
}

model StoreSettings {
  id               String   @id @default("singleton")
  storeName        String?
  description      String?  @db.Text
  contactPhone     String?
  whatsappNumber   String?
  email            String?
  address          Json?
  shippingSettings Json?
  currency         String?
  defaultLocale    Locale   @default(AR)
  isActive         Boolean  @default(true)
  configuration    Json?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  @@map("store_settings")
}

model CustomerAddress {
  id          String   @id @default(cuid())
  userId      String
  fullName    String
  phone       String
  addressLine String   @db.Text
  city        String
  postalCode  String?
  notes       String?  @db.Text
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId], where: { isDefault: true })
  @@index([userId, createdAt])
  @@map("customer_addresses")
}

model StoreSeoSettings {
  id                String   @id @default(cuid())
  locale            Locale   @unique
  siteTitle         String?
  description       String?  @db.Text
  canonicalBaseUrl  String?
  defaultOgImageUrl String?  @db.Text
  configuration     Json?
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  @@map("store_seo_settings")
}

model FAQ {
  id        String   @id @default(cuid())
  isActive  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  translations FAQTranslation[]

  @@index([isActive, sortOrder])
  @@map("faqs")
}

model FAQTranslation {
  id       String @id @default(cuid())
  faqId    String
  locale   Locale
  question String
  answer   String @db.Text
  faq      FAQ    @relation(fields: [faqId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([faqId, locale])
  @@map("faq_translations")
}

model ContentPage {
  id        String   @id @default(cuid())
  pageKey   String   @unique
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  translations ContentPageTranslation[]

  @@map("content_pages")
}

model ContentPageTranslation {
  id             String      @id @default(cuid())
  contentPageId  String
  locale         Locale
  title          String
  slug           String
  body           String      @db.Text
  seoTitle       String?
  seoDescription String?     @db.Text
  contentPage    ContentPage @relation(fields: [contentPageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([contentPageId, locale])
  @@unique([locale, slug])
  @@map("content_page_translations")
}

model NotificationOutbox {
  id                String             @id @default(cuid())
  eventKey          String             @unique
  eventType         String
  orderId           String?
  recipient         String
  payload           Json
  status            NotificationStatus @default(PENDING)
  retryCount        Int                @default(0)
  lastAttemptAt     DateTime?          @db.Timestamptz(3)
  nextAttemptAt     DateTime?          @db.Timestamptz(3)
  deliveryUnknown   Boolean            @default(false)
  errorMessage      String?            @db.Text
  providerMessageId String?
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status, nextAttemptAt, createdAt])
  @@index([status, lastAttemptAt])
  @@index([status, createdAt])
  @@index([orderId])
  @@map("notification_outbox")
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  requestId   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([requestId])
  @@map("admin_audit_logs")
}

model SlugRedirect {
  id           String   @id @default(cuid())
  oldSlug      String
  newSlug      String
  locale       Locale
  resourceType String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@unique([resourceType, locale, oldSlug])
  @@index([locale, newSlug])
  @@map("slug_redirects")
}

model ChatConversation {
  id             String   @id @default(cuid())
  userId         String?
  customerId     String?
  guestTokenHash String?
  metadata       Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  customer Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@index([customerId, updatedAt])
  @@index([guestTokenHash, updatedAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           ChatRole
  content        String   @db.Text
  metadata       Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}
